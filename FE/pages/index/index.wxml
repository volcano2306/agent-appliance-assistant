<view class="page">
  <!-- 自定义导航栏 -->
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px">
    <view class="nav-bar">
      <!-- 左侧：AI 圆角长方形按钮（可点击） -->
      <view class="nav-ai-btn" bindtap="onQuarterTap"></view>
      <!-- 搜索图标（可点击） -->
      <view class="nav-search" bindtap="onSearchTap">
        <image src="/images/home/MCPNG/search_3_line.png" class="nav-icon-img" mode="aspectFit"></image>
      </view>
      <!-- 标题水平居中（不可点击） -->
      <text class="nav-title">家电轻手册</text>
    </view>
  </view>

  <!-- 导航栏占位高度 -->
  <view style="height: {{navHeight}}px"></view>

  <!-- 可滚动内容区 -->
  <scroll-view scroll-y class="main-scroll" style="height: {{scrollHeight}}px">
    <!-- 功能导航（无外圈圆，仅图标+文字） -->
    <view class="nav-row">
      <view class="nav-item" wx:for="{{navItems}}" wx:key="type">
        <!-- Logo图标（可点击） -->
        <view class="nav-icon-btn" bindtap="onNavTap" data-type="{{item.type}}">
          <image src="{{item.iconImage}}" class="nav-func-img" mode="aspectFit"></image>
        </view>
        <!-- 标签文字（不可点击） -->
        <text class="nav-label">{{item.label}}</text>
      </view>
    </view>

    <!-- 我的说明书板块（标题常驻） -->
    <view class="manual-section" bindtap="onManualSectionTap">
      <text class="manual-title">我的说明书</text>

      <!-- 说明书卡片网格（更多卡片，可滚动） -->
      <view class="manual-grid" wx:if="{{manuals.length > 0}}">
        <view 
          class="manual-card" 
          wx:for="{{manuals}}" 
          wx:key="id"
          bindtap="onManualTap"
          bindlongpress="onManualLongPress"
          data-id="{{item.id}}"
          data-item="{{item}}"
        >
          <view
            class="delete-bubble"
            wx:if="{{deleteManualId === item.id}}"
            catchtap="onDeleteTap"
            data-id="{{item.id}}"
          >
            删除
          </view>
          <!-- 图片区 -->
          <view class="card-img-area">
            <image 
              wx:if="{{item.image}}" 
              src="{{item.image}}" 
              mode="aspectFill" 
              class="card-image"
            ></image>
            <view wx:else class="card-placeholder">
              <text class="placeholder-text">图片</text>
            </view>
          </view>
          <!-- 命名区 -->
          <view class="card-name-area">
            <text class="card-name">{{item.name}}</text>
          </view>
        </view>
      </view>
      <view class="manual-empty" wx:else>
        暂无已添加说明书，长按卡片可删除。
      </view>
    </view>

    <!-- 底部留白（到TabBar横条顶部） -->
    <view style="height: {{tabBarHeight}}px;"></view>
  </scroll-view>
</view>