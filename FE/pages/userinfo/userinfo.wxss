/* ========== 页面基础 ========== */
page {
  background: #205D4C;
}

.page {
  min-height: 100vh;
  background: #205D4C;
  display: flex;
  flex-direction: column;
}

/* ========== 自定义导航栏 ========== */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: transparent;
}

.nav-bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
  position: relative;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-text {
  color: #ffffff;
  font-size: 56rpx;
  line-height: 1;
  margin-top: -4rpx;
}

.nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  white-space: nowrap;
}

/* ========== 内容区 ========== */
.content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 40rpx 0;
}

/* ========== 头像区 ========== */
.avatar-area {
  position: relative;
  width: 200rpx;
  height: 210rpx;
  margin-bottom: 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
}

/* 头像主圆 */
.avatar-circle {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  overflow: visible;
  z-index: 1;
  margin-top: 4rpx;
}

.avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: block;
  overflow: hidden;
}

/* 无头像时的占位底色 */
.avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
}

/* 相机图标徽章（右下角） */
.avatar-camera-badge {
  position: absolute;
  bottom: -6rpx;
  right: -6rpx;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: #E9AE0E;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
  border: 3rpx solid #205D4C;
}

.badge-icon {
  width: 28rpx;
  height: 28rpx;
}

/* ========== 信息列表 ========== */
.info-list {
  width: 100%;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 64rpx;
}

.info-item {
  display: flex;
  align-items: center;
  padding: 36rpx 32rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 500;
  width: 128rpx;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.6);
  text-align: left;
}

.info-arrow {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1;
  flex-shrink: 0;
}

/* ========== 退出登录按钮 ========== */
.logout-btn {
  width: 100%;
  padding: 24rpx 0;
  border: 2rpx solid #E9AE0E;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logout-text {
  font-size: 32rpx;
  color: #E9AE0E;
  font-weight: 500;
}

/* ========== 弹窗遮罩 ========== */
.popup-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* hidden 时隐藏 */
.popup-overlay[hidden] {
  display: none !important;
}

/* ========== 弹窗主体 ========== */
.popup-box {
  width: 620rpx;
  background: #1e5040;
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 36rpx 24rpx;
}

.popup-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
}

.popup-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.popup-close-text {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1;
}

.popup-input {
  margin: 0 36rpx 32rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.popup-placeholder {
  color: rgba(255, 255, 255, 0.4);
}

.popup-desc {
  display: block;
  margin: 0 36rpx 36rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.75);
  line-height: 1.6;
}

.popup-phone-auth {
  margin: -10rpx 36rpx 26rpx;
}

.phone-auth-btn {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 12rpx;
  background: rgba(233, 174, 14, 0.22);
  color: #ffe6a2;
  font-size: 26rpx;
  border: 1rpx solid rgba(233, 174, 14, 0.45);
}

/* ========== 弹窗底部按钮 ========== */
.popup-footer {
  display: flex;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.popup-btn {
  flex: 1;
  padding: 32rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.popup-btn + .popup-btn {
  border-left: 1rpx solid rgba(255, 255, 255, 0.1);
}

.popup-btn-text {
  font-size: 30rpx;
  font-weight: 500;
}

.cancel-btn .popup-btn-text {
  color: rgba(255, 255, 255, 0.65);
}

.confirm-btn .popup-btn-text {
  color: #E9AE0E;
}

.danger-btn .popup-btn-text {
  color: #ff6b6b;
}
