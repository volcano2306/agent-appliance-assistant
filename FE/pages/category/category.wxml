<view class="page">
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px">
    <view class="nav-bar">
      <view class="nav-back" bindtap="onBackTap">
        <text class="nav-back-text">‹</text>
      </view>
      <view class="nav-ai-btn" bindtap="onQuarterTap"></view>
      <view class="nav-search" bindtap="onSearchTap">
        <image src="/images/home/MCPNG/search_3_line.png" class="nav-icon-img" mode="aspectFit"></image>
      </view>
      <text class="nav-title">分类浏览</text>
    </view>
  </view>

  <view style="height: {{navHeight}}px"></view>

  <view class="path-bar">
    <text class="path-text">{{currentPathText}}</text>
  </view>

  <view class="layout-wrap" style="height: {{contentHeight}}px">
    <scroll-view scroll-y class="first-level-panel">
      <view
        class="first-level-item {{item === selectedFirstLevel ? 'first-level-item-active' : ''}}"
        wx:for="{{firstLevelList}}"
        wx:key="*this"
        bindtap="onFirstLevelTap"
        data-level="{{item}}"
      >
        <text class="first-level-text">{{item}}</text>
      </view>
    </scroll-view>

    <scroll-view scroll-y class="content-panel">
      <view wx:if="{{selectedFirstLevel === '相机'}}" class="filter-block">
        <text class="block-title">设备类型筛选</text>
        <view class="chip-wrap">
          <view
            class="chip {{item === selectedCameraSecondLevel ? 'chip-active' : ''}}"
            wx:for="{{cameraSecondLevelList}}"
            wx:key="*this"
            bindtap="onCameraSecondLevelTap"
            data-level="{{item}}"
          >
            {{item}}
          </view>
        </view>
      </view>

      <view wx:if="{{selectedFirstLevel !== '全部'}}" class="filter-block">
        <text class="block-title">品牌筛选</text>
        <view class="chip-wrap">
          <view
            class="chip brand-chip {{item === selectedBrand ? 'chip-active' : ''}}"
            wx:for="{{brandList}}"
            wx:key="*this"
            bindtap="onBrandTap"
            data-brand="{{item}}"
          >
            {{item}}
          </view>
        </view>
      </view>

      <view class="preview-head">
        <text class="preview-title">说明书预览</text>
        <text class="preview-count">共 {{manuals.length}} 条</text>
      </view>

      <view wx:if="{{loading}}" class="empty-box">
        <text class="empty-text">加载中...</text>
      </view>
      <view wx:elif="{{manuals.length === 0}}" class="empty-box">
        <text class="empty-text">当前筛选暂无说明书</text>
      </view>

      <view wx:else class="manual-grid">
        <view
          class="manual-card"
          wx:for="{{manuals}}"
          wx:key="id"
          bindtap="onManualTap"
          data-item="{{item}}"
        >
          <view class="card-cover-wrap">
            <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="card-image"></image>
            <view wx:else class="card-placeholder">
              <text class="placeholder-text">封面</text>
            </view>
          </view>

          <view class="card-content">
            <text class="card-name">{{item.name}}</text>
            <text class="card-model" wx:if="{{item.model}}">型号 {{item.model}}</text>
            <view class="tag-row">
              <text class="tag brand">{{item.brandName}}</text>
              <text class="tag category">{{item.firstLevel}} · {{item.secondLevel}}</text>
            </view>
          </view>
        </view>
      </view>

      <view style="height: {{tabBarHeight}}px;"></view>
    </scroll-view>
  </view>
</view>
