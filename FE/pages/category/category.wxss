page {
  background: linear-gradient(180deg, #1a5847 0%, #205d4c 42%, #245f4f 100%);
}

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a5847 0%, #205d4c 42%, #245f4f 100%);
  display: flex;
  flex-direction: column;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: linear-gradient(180deg, rgba(19, 69, 56, 0.95) 0%, rgba(19, 69, 56, 0.55) 75%, rgba(19, 69, 56, 0) 100%);
}

.nav-bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
  position: relative;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nav-back-text {
  color: #ffffff;
  font-size: 56rpx;
  line-height: 1;
  margin-top: -4rpx;
}

.nav-ai-btn {
  width: 64rpx;
  height: 64rpx;
  background: #e9ae0e;
  border-radius: 20rpx 8rpx 20rpx 8rpx;
  flex-shrink: 0;
}

.nav-search {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.nav-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.94);
  white-space: nowrap;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}

.path-bar {
  padding: 12rpx 24rpx 14rpx;
  background: rgba(31, 84, 68, 0.58);
  border-top: 1rpx solid rgba(224, 237, 229, 0.08);
  border-bottom: 1rpx solid rgba(224, 237, 229, 0.08);
}

.path-text {
  color: rgba(230, 238, 231, 0.82);
  font-size: 22rpx;
}

.layout-wrap {
  display: flex;
  width: 100%;
  box-sizing: border-box;
}

.first-level-panel {
  width: 190rpx;
  height: 100%;
  background: rgba(24, 73, 59, 0.48);
  border-right: 1rpx solid rgba(219, 234, 224, 0.12);
}

.first-level-item {
  min-height: 96rpx;
  padding: 20rpx 12rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid rgba(214, 230, 219, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.first-level-item-active {
  background: rgba(233, 174, 14, 0.18);
  border-left: 6rpx solid #efbc1b;
}

.first-level-text {
  color: rgba(237, 246, 239, 0.92);
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
  line-height: 1.35;
}

.second-side-wrap {
  border-top: 1rpx solid rgba(214, 230, 219, 0.12);
  margin-top: 8rpx;
  padding-top: 10rpx;
}

.second-side-title {
  color: rgba(226, 237, 229, 0.68);
  font-size: 20rpx;
  padding: 0 12rpx 8rpx;
  text-align: center;
}

.second-side-item {
  min-height: 84rpx;
  padding: 14rpx 10rpx;
  border-bottom: 1rpx solid rgba(214, 230, 219, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.second-side-item-active {
  background: rgba(233, 174, 14, 0.16);
  border-left: 6rpx solid rgba(239, 188, 27, 0.95);
}

.second-side-text {
  color: rgba(238, 246, 240, 0.9);
  font-size: 22rpx;
  font-weight: 500;
  text-align: center;
  line-height: 1.3;
}

.content-panel {
  flex: 1;
  height: 100%;
  padding: 16rpx 16rpx 0;
  box-sizing: border-box;
}

.filter-block {
  margin-bottom: 16rpx;
}

.block-title {
  display: block;
  font-size: 24rpx;
  color: rgba(229, 238, 231, 0.9);
  margin-bottom: 10rpx;
}

.chip-wrap {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  padding: 10rpx 18rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(225, 237, 228, 0.22);
  background: rgba(105, 152, 136, 0.22);
  color: #eaf4ec;
  font-size: 22rpx;
}

.brand-chip {
  background: rgba(67, 120, 135, 0.2);
  border-color: rgba(177, 214, 224, 0.32);
}

.chip-active {
  background: rgba(233, 174, 14, 0.24);
  border-color: rgba(233, 174, 14, 0.58);
  color: #ffe7ad;
}

.preview-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 8rpx 0 12rpx;
}

.preview-title {
  font-size: 30rpx;
  color: #eef7ef;
  font-weight: 700;
}

.preview-count {
  font-size: 22rpx;
  color: rgba(220, 233, 224, 0.72);
}

.empty-box {
  margin-top: 14rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.1);
  padding: 52rpx 26rpx;
  text-align: center;
}

.empty-text {
  color: rgba(230, 239, 232, 0.78);
  font-size: 24rpx;
}

.manual-grid {
  display: block;
}

.manual-card {
  border-radius: 18rpx;
  overflow: hidden;
  margin-bottom: 14rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(228, 239, 232, 0.15);
  display: flex;
}

.card-cover-wrap {
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.08);
}

.card-image {
  width: 100%;
  height: 100%;
}

.card-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-text {
  color: rgba(231, 240, 234, 0.52);
  font-size: 24rpx;
}

.card-content {
  flex: 1;
  padding: 14rpx;
  box-sizing: border-box;
}

.card-name {
  display: block;
  font-size: 26rpx;
  color: #f1f8f2;
  font-weight: 700;
  line-height: 1.4;
}

.card-model {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(221, 234, 225, 0.76);
}

.tag-row {
  margin-top: 12rpx;
}

.tag {
  display: inline-block;
  font-size: 20rpx;
  border-radius: 999rpx;
  padding: 6rpx 12rpx;
  margin-right: 8rpx;
  margin-bottom: 6rpx;
}

.tag.brand {
  background: rgba(74, 136, 152, 0.32);
  border: 1rpx solid rgba(177, 216, 226, 0.4);
  color: #d8f0f7;
}

.tag.category {
  background: rgba(106, 154, 124, 0.28);
  border: 1rpx solid rgba(203, 227, 212, 0.32);
  color: #e2f2e6;
}
