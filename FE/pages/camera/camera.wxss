/* 页面容器 */
.page {
  width: 100%;
  height: 100vh;
  background: #F5F5F5;
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: #205D4C;
  z-index: 1000;
}

.nav-bar {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 16px;
  position: relative;
}

/* 返回按钮 */
.nav-back-btn {
  position: absolute;
  left: 16px;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-text {
  font-size: 48rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
}

/* 标题 */
.nav-title {
  font-size: 18px;
  font-weight: 600;
  color: #FFFFFF;
}

/* 右侧占位 */
.nav-placeholder {
  position: absolute;
  right: 16px;
  width: 32px;
  height: 32px;
}

/* 主滚动区 */
.main-scroll {
  width: 100%;
  background: #F5F5F5;
}

/* 说明书板块 */
.manual-section {
  padding: 20px 16px;
}

.manual-title {
  font-size: 20px;
  font-weight: 600;
  color: #205D4C;
  display: block;
  margin-bottom: 16px;
}

/* 说明书网格 */
.manual-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

/* 说明书卡片 */
.manual-card {
  background: #FFFFFF;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

/* 图片区域 */
.card-img-area {
  width: 100%;
  height: 160px;
  overflow: hidden;
  background: #E8E8E8;
  position: relative;
}

.card-image {
  width: 100%;
  height: 100%;
}

.card-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #6B906F 0%, #205D4C 100%);
}

.placeholder-text {
  font-size: 14px;
  color: #FFFFFF;
  opacity: 0.8;
}

/* 命名区域 */
.card-name-area {
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.card-name {
  font-size: 14px;
  font-weight: 500;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-brand {
  font-size: 12px;
  color: #999999;
}

/* 空状态 */
.empty-state {
  padding: 60px 0;
  text-align: center;
}

.empty-text {
  font-size: 14px;
  color: #999999;
}
