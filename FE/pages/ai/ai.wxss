page {
  background: #F5F7FA;
}

.page {
  min-height: 100vh;
  background: #F5F7FA;
  display: flex;
  flex-direction: column;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #5C8668;
  box-shadow: none;
}

.nav-bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
  position: relative;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-text {
  color: rgba(255, 255, 255, 0.9);
  font-size: 52rpx;
  line-height: 1;
  margin-top: -4rpx;
}

.nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 34rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.session-bar {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 95;
  background: rgba(245, 247, 250, 0.96);
  backdrop-filter: blur(10px);
}

.session-bar-inner {
  height: 100%;
  padding: 10rpx 24rpx 12rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.session-bar-left {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.session-bar-title {
  color: #333333;
  font-size: 24rpx;
  font-weight: 600;
}

.session-bar-subtitle {
  color: #94A3B8;
  font-size: 20rpx;
}

.session-bar-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.session-action-btn {
  min-width: 96rpx;
  height: 56rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  color: #666666;
  border: 2rpx solid #E7ECF2;
  border-radius: 18rpx;
  font-size: 24rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.session-action-primary {
  color: #2B5A4A;
  border-color: #D8E4DD;
  background: #EAF2EF;
}

.session-action-disabled {
  opacity: 0.52;
}

.history-mask {
  position: fixed;
  inset: 0;
  z-index: 120;
  background: rgba(15, 23, 42, 0.18);
  animation: history-mask-in 0.18s ease;
}

.history-panel {
  position: absolute;
  top: 0;
  right: 0;
  width: 540rpx;
  height: 100vh;
  background: #FFFFFF;
  box-shadow: -16rpx 0 48rpx rgba(15, 23, 42, 0.12);
  padding: 120rpx 24rpx 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  animation: history-panel-in 0.22s cubic-bezier(0.22, 1, 0.36, 1);
}

.history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.history-head-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.history-title {
  color: #333333;
  font-size: 32rpx;
  font-weight: 700;
}

.history-subtitle {
  color: #94A3B8;
  font-size: 22rpx;
}

.history-scroll {
  flex: 1;
}

.history-item {
  padding: 18rpx 18rpx 16rpx;
  border-radius: 18rpx;
  background: #F7F9FC;
  border: 2rpx solid transparent;
  margin-bottom: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  animation: history-item-in 0.24s ease both;
}

.history-item-active {
  border-color: #D8E4DD;
  background: #EAF2EF;
}

.history-item-head {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.history-item-title-wrap {
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.history-item-title {
  color: #333333;
  font-size: 28rpx;
  font-weight: 600;
  flex: 1;
}

.history-item-time {
  color: #94A3B8;
  font-size: 22rpx;
  flex-shrink: 0;
}

.history-item-manage {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  border: 2rpx solid #E7ECF2;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: transform 0.18s ease, background 0.18s ease;
}

.history-item-manage-text {
  color: #94A3B8;
  font-size: 34rpx;
  line-height: 1;
  margin-top: -8rpx;
}

.history-item-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.history-tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1;
}

.history-tag-manual {
  color: #2B5A4A;
  background: #EAF2EF;
}

.history-tag-brand {
  color: #5D6B66;
  background: #F1F5F9;
}

.history-tag-neutral {
  color: #768291;
  background: #EEF2F7;
}

.history-tag-highlight {
  color: #FFFFFF;
  background: #2B5A4A;
}

.history-item-preview {
  color: #666666;
  font-size: 24rpx;
  line-height: 1.6;
}

.history-loading,
.history-empty {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 12rpx;
}

.history-loading-text,
.history-empty-title {
  color: #333333;
  font-size: 28rpx;
  font-weight: 600;
}

.history-empty-text {
  color: #999999;
  font-size: 24rpx;
  line-height: 1.7;
  text-align: center;
}

.history-empty-illustration {
  width: 112rpx;
  height: 112rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #EAF2EF 0%, #F7F9FC 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 2rpx #E7ECF2;
}

.history-empty-illustration-text {
  color: #2B5A4A;
  font-size: 34rpx;
  font-weight: 700;
}

.history-empty-action {
  min-width: 220rpx;
  height: 64rpx;
  padding: 0 26rpx;
  border-radius: 18rpx;
  background: #EAF2EF;
  color: #2B5A4A;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rename-mask {
  position: fixed;
  inset: 0;
  z-index: 130;
  background: rgba(15, 23, 42, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 36rpx;
  box-sizing: border-box;
  animation: history-mask-in 0.18s ease;
}

.rename-dialog {
  width: 100%;
  border-radius: 26rpx;
  background: #FFFFFF;
  padding: 30rpx 28rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  box-shadow: 0 16rpx 48rpx rgba(15, 23, 42, 0.16);
  animation: rename-dialog-in 0.22s cubic-bezier(0.22, 1, 0.36, 1);
}

.rename-title {
  color: #333333;
  font-size: 32rpx;
  font-weight: 700;
}

.rename-subtitle {
  color: #94A3B8;
  font-size: 24rpx;
  line-height: 1.6;
}

.rename-input {
  width: 100%;
  height: 88rpx;
  border-radius: 18rpx;
  background: #F7F9FC;
  border: 2rpx solid #E7ECF2;
  padding: 0 22rpx;
  box-sizing: border-box;
  color: #333333;
  font-size: 28rpx;
}

.rename-actions {
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
}

.rename-btn {
  min-width: 128rpx;
  height: 68rpx;
  border-radius: 18rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rename-btn-secondary {
  color: #666666;
  background: #F7F9FC;
}

.rename-btn-primary {
  color: #FFFFFF;
  background: #2B5A4A;
}

.history-item-manage:active,
.source-card:active,
.upload-btn:active,
.send-btn:active,
.remove-ref:active {
  transform: scale(0.98);
}

@keyframes history-mask-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes history-panel-in {
  from {
    opacity: 0;
    transform: translate3d(56rpx, 0, 0);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
}

@keyframes history-item-in {
  from {
    opacity: 0;
    transform: translate3d(0, 18rpx, 0);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
}

@keyframes rename-dialog-in {
  from {
    opacity: 0;
    transform: translate3d(0, 26rpx, 0) scale(0.97);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }
}

.chat-scroll {
  box-sizing: border-box;
}

.chat-list {
  padding: 24rpx 24rpx 18rpx;
}

.msg-row {
  margin-bottom: 20rpx;
  width: 100%;
  display: flex;
}

.ai-row {
  justify-content: flex-start;
}

.user-row {
  justify-content: flex-end;
}

.ai-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #FFFFFF;
  border: 2rpx solid #E5EEE8;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
  box-shadow: 0 8rpx 20rpx rgba(43, 90, 74, 0.08);
}

.ai-avatar-logo {
  width: 42rpx;
  height: 42rpx;
}

.msg-bubble {
  max-width: 72%;
  border-radius: 22rpx;
  padding: 16rpx 18rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ai-bubble {
  background: #FFFFFF;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.05);
}

.user-bubble {
  background: #EAF2EF;
}

.msg-text {
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}

.ai-text {
  color: #333333;
}

.answer-status-card {
  border-radius: 18rpx;
  padding: 16rpx 18rpx;
  background: #FFF7ED;
  border: 1rpx solid #FBD7A7;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.answer-status-title {
  color: #B45309;
  font-size: 24rpx;
  font-weight: 600;
}

.answer-status-text {
  color: #9A6B2E;
  font-size: 22rpx;
  line-height: 1.6;
}

.answer-structured {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.answer-section {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.answer-section-muted {
  padding-top: 4rpx;
  border-top: 1rpx solid #EEF2F7;
}

.answer-section-label {
  color: #2B5A4A;
  font-size: 23rpx;
  font-weight: 700;
}

.answer-summary,
.answer-basis {
  color: #333333;
  font-size: 27rpx;
  line-height: 1.7;
}

.answer-basis {
  color: #5D6B66;
  font-size: 24rpx;
}

.answer-list-item,
.answer-caution-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.answer-list-index {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #EAF2EF;
  color: #2B5A4A;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.answer-list-text {
  flex: 1;
  color: #333333;
  font-size: 26rpx;
  line-height: 1.7;
}

.answer-caution-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #D97706;
  flex-shrink: 0;
  margin-top: 16rpx;
}

.user-text {
  color: #2B5A4A;
}

.preview-img {
  width: 280rpx;
  height: 200rpx;
  border-radius: 14rpx;
}

.manual-ref {
  border-radius: 14rpx;
  padding: 10rpx 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.in-msg-ref {
  background: #2B5A4A;
}

.user-msg-ref {
  background: rgba(43, 90, 74, 0.14);
}

.manual-ref-name {
  color: #FFFFFF;
  font-size: 24rpx;
}

.manual-ref-tag {
  color: #D5E0DA;
  font-size: 22rpx;
}

.source-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.source-list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.source-list-title {
  color: #5D6B66;
  font-size: 22rpx;
  font-weight: 600;
}

.source-list-count {
  color: #94A3B8;
  font-size: 20rpx;
}

.source-card {
  background: #F7F9FC;
  border: 1rpx solid #E7ECF2;
  border-radius: 16rpx;
  padding: 14rpx 16rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.source-page {
  color: #2B5A4A;
  font-size: 22rpx;
  font-weight: 600;
}

.source-snippet {
  color: #666666;
  font-size: 22rpx;
  line-height: 1.6;
}

.source-jump {
  color: #2B5A4A;
  font-size: 22rpx;
  font-weight: 600;
}

.input-wrap {
  border-top: none;
  background: #5C8668;
  padding: 12rpx 18rpx;
  box-sizing: border-box;
  box-shadow: none;
}

.selected-manual-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.selected-ref {
  flex: 1;
  background: #EAF2EF;
}

.remove-ref {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  color: #666666;
  border: 2rpx solid #E7ECF2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.input-row {
  display: flex;
  align-items: flex-end;
  gap: 10rpx;
}

.upload-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.voice-btn {
  min-width: 72rpx;
  height: 64rpx;
  padding: 0 12rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #2B5A4A;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.voice-btn-recording {
  color: #FFFFFF;
  background: #C2414A;
}

.voice-btn-disabled {
  opacity: 0.6;
}

.voice-status-row {
  min-height: 44rpx;
  margin-bottom: 8rpx;
  padding: 0 8rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.voice-status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.72);
}

.voice-status-dot-recording {
  background: #FFCED2;
  animation: voice-pulse 1s ease-in-out infinite;
}

.voice-status-text {
  color: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
}

@keyframes voice-pulse {
  0%, 100% { opacity: 0.45; transform: scale(0.85); }
  50% { opacity: 1; transform: scale(1.15); }
}

.upload-icon {
  width: 38rpx;
  height: 38rpx;
}

.chat-input {
  flex: 1;
  min-height: 64rpx;
  max-height: 170rpx;
  border-radius: 16rpx;
  padding: 14rpx 16rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #1f2937;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.send-btn {
  height: 64rpx;
  min-width: 96rpx;
  border-radius: 16rpx;
  padding: 0 20rpx;
  background: #2B5A4A;
  color: #FFFFFF;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
