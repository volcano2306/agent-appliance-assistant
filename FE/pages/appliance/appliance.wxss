page {
  background: #205d4c;
}

.page {
  min-height: 100vh;
  background: #205d4c;
  display: flex;
  flex-direction: column;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: #205d4c;
}

.nav-bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 32rpx;
  position: relative;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.nav-back-text {
  color: #ffffff;
  font-size: 52rpx;
  line-height: 1;
  margin-top: -4rpx;
}

.nav-ai-btn {
  width: 64rpx;
  height: 64rpx;
  background: #e9ae0e;
  border-radius: 20rpx 8rpx 20rpx 8rpx;
  flex-shrink: 0;
}

.nav-search {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.nav-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #ffffff;
  white-space: nowrap;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.main-scroll {
  background: #205d4c;
}

.content-wrap {
  padding: 20rpx 30rpx 24rpx;
}

.hero-box {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
  margin-bottom: 22rpx;
}

.hero-image-wrap {
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.45);
  background: rgba(255, 255, 255, 0.08);
  flex-shrink: 0;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 32rpx;
}

.hero-meta {
  flex: 1;
  min-height: 200rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.hero-name {
  display: block;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.hero-intro {
  display: block;
  color: #d7dfdb;
  font-size: 28rpx;
  line-height: 1.6;
}

.preview-box {
  border-radius: 24rpx;
  background: #ffffff;
  padding: 16rpx;
  margin-bottom: 18rpx;
}

.preview-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.preview-title {
  color: #205d4c;
  font-size: 30rpx;
  font-weight: 600;
}

.download-btn {
  height: 50rpx;
  min-width: 100rpx;
  border-radius: 12rpx;
  background: #205d4c;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 16rpx;
}

.download-text {
  color: #ffffff;
  font-size: 24rpx;
}

.preview-scroll {
  width: 100%;
  background: #ffffff;
}

.preview-page {
  width: 100%;
  margin-bottom: 8rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 8rpx;
}

.manual-text {
  display: block;
  color: #222222;
  font-size: 30rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

.comment-board {
  margin-top: 16rpx;
  border-radius: 22rpx;
  background: #ffffff;
  padding: 20rpx;
}

.comment-summary {
  color: #2f3634;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.comment-card {
  border-bottom: 1rpx solid #e6ece9;
  padding: 22rpx 0;
}

.comment-card:last-child {
  border-bottom: none;
}

.comment-head {
  display: flex;
  align-items: flex-start;
}

.comment-avatar-img,
.comment-avatar-text {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
}

.comment-avatar-img {
  display: block;
}

.comment-avatar-text {
  background: #205d4c;
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.comment-meta {
  margin-left: 14rpx;
  display: flex;
  flex-direction: column;
}

.comment-name {
  font-size: 28rpx;
  color: #1e2b27;
  font-weight: 600;
}

.comment-time {
  font-size: 22rpx;
  color: #8f9693;
}

.comment-content {
  margin-top: 12rpx;
  color: #24312d;
  font-size: 27rpx;
  line-height: 1.6;
}

.comment-footer {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.comment-left-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.comment-reply {
  color: #566663;
  font-size: 24rpx;
}

.comment-like {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #7e8784;
}

.comment-heart {
  font-size: 40rpx;
  line-height: 1;
}

.comment-like-count {
  font-size: 22rpx;
}

.comment-like.is-active {
  color: #f14f63;
  font-weight: 600;
}

.reply-list {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: #f1f5f3;
}

.reply-item {
  margin-bottom: 10rpx;
}

.reply-item:last-child {
  margin-bottom: 0;
}

.reply-head {
  display: flex;
  align-items: flex-start;
}

.reply-avatar-img,
.reply-avatar-text {
  width: 24rpx;
  height: 24rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.reply-avatar-img {
  display: block;
}

.reply-avatar-text {
  background: #205d4c;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11rpx;
}

.reply-meta {
  margin-left: 0;
  flex: 1;
}

.reply-name {
  color: #7f8a86;
  font-size: 24rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 6rpx;
}

.reply-body {
  color: #24312d;
  font-size: 24rpx;
  line-height: 1.65;
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}

.reply-prefix {
  color: #24312d;
  font-weight: 600;
}

.reply-target {
  color: #2e3b37;
  font-weight: 600;
}

.reply-colon {
  color: #24312d;
}

.reply-content {
  color: #24312d;
}

.reply-footer {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.reply-left-actions {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.reply-time {
  color: #8f9693;
  font-size: 22rpx;
}

.reply-reply {
  color: #8f9693;
  font-size: 22rpx;
}

.reply-like {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: #96a09d;
}

.reply-heart {
  font-size: 28rpx;
  line-height: 1;
}

.reply-like-count {
  font-size: 20rpx;
}

.reply-like.is-active {
  color: #f14f63;
}

.comment-empty {
  text-align: center;
  color: #6f7975;
  padding: 26rpx 0;
  font-size: 24rpx;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.18);
  background: rgba(107, 144, 111, 0.8);
  padding: 10rpx 20rpx 10rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-sizing: border-box;
}

.comment-input {
  height: 64rpx;
  flex: 1;
  border-radius: 16rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.08);
}

.comment-input-text {
  color: #ffffff;
  font-size: 32rpx;
}

.action-icons {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.icon-btn {
  width: 82rpx;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.like-btn {
  width: 82rpx;
  min-width: 82rpx;
}

.like-btn.is-active {
  opacity: 1;
}

.collect-btn.is-active {
  opacity: 1;
}

.icon-img {
  width: 44rpx;
  height: 44rpx;
}
