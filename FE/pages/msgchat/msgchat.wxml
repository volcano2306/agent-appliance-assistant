<view class="page">

  <!-- 自定义导航栏 -->
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px">
    <view class="nav-bar">
      <!-- 左：退出、清除、免打扰 -->
      <view class="nav-left">
        <view class="nav-back" bindtap="onBackTap">
          <text class="nav-back-text">‹</text>
        </view>
        <view class="nav-clear-btn" bindtap="onClearChatTap">
          <text class="nav-clear-text">清除</text>
        </view>
        <view class="nav-mute-btn" bindtap="onMuteTap">
          <image src="{{isMuted ? '/images/xiaoxi/mute_off.png' : '/images/xiaoxi/mute_on.png'}}" class="mute-icon" mode="aspectFit"></image>
        </view>
      </view>
      <!-- 中：聊天名称（绝对居中） -->
      <text class="nav-chat-name">{{chatName}}</text>
    </view>
  </view>

  <!-- 导航栏占位 -->
  <view style="height: {{navHeight}}px"></view>

  <!-- 消息列表 -->
  <scroll-view
    scroll-y
    class="chat-scroll"
    style="height: {{chatHeight}}px"
    scroll-with-animation
    scroll-top="{{scrollTop}}"
    scroll-into-view="{{scrollIntoView}}"
  >
    <view class="chat-list">
      <view
        wx:for="{{messages}}"
        wx:key="id"
        id="msg-{{item.id}}"
        class="msg-row {{item.role === 'me' ? 'me-row' : 'other-row'}}"
      >
        <block wx:if="{{item.role === 'other'}}">
          <view class="chat-avatar">
            <image wx:if="{{item.avatar}}" src="{{item.avatar}}" class="avatar-img other-avatar-img" mode="aspectFit"></image>
            <view wx:else class="avatar-placeholder other-ph"></view>
          </view>
          <view class="msg-bubble other-bubble">
            <text class="msg-text other-text">{{item.text}}</text>
          </view>
        </block><block wx:else>
          <view class="msg-bubble me-bubble">
            <text class="msg-text me-text">{{item.text}}</text>
          </view>
          <view class="chat-avatar">
            <image wx:if="{{myAvatar}}" src="{{myAvatar}}" class="avatar-img" mode="aspectFit"></image>
            <view wx:else class="avatar-placeholder me-ph"></view>
          </view>
        </block>
      </view>
    </view>
  </scroll-view>

  <!-- 输入区 -->
  <view class="input-wrap" style="padding-bottom: {{safeAreaBottom}}px">
    <view class="input-row">
      <textarea
        class="chat-input"
        value="{{inputText}}"
        bindinput="onInputChange"
        placeholder="输入消息..."
        placeholder-class="input-placeholder"
        auto-height
        maxlength="-1"
        adjust-position="{{false}}"
      ></textarea>
      <view class="send-btn {{inputText ? '' : 'send-btn-disabled'}}" bindtap="onSendTap">
        <text class="send-text">发送</text>
      </view>
    </view>
  </view>

</view>
