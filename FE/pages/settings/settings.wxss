page {
  background: #205d4c;
}

.page {
  min-height: 100vh;
  background: #205d4c;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: transparent;
}

.nav-bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 28rpx;
  position: relative;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-text {
  color: #ffffff;
  font-size: 58rpx;
  line-height: 1;
  margin-top: -4rpx;
  transform: rotate(180deg);
}

.nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 38rpx;
  color: #ffffff;
  font-weight: 700;
}

.main-scroll {
  background: #205d4c;
}

.page-content {
  padding: 20rpx 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.section-card {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  padding: 22rpx 18rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.section-head {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.section-title {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
}

.section-subtitle {
  color: rgba(255, 255, 255, 0.62);
  font-size: 25rpx;
}

.setting-row,
.switch-row {
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  min-height: 96rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.setting-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.setting-label {
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 600;
}

.setting-desc {
  color: rgba(255, 255, 255, 0.62);
  font-size: 24rpx;
  line-height: 1.5;
}

.setting-arrow {
  color: rgba(255, 255, 255, 0.65);
  font-size: 34rpx;
  line-height: 1;
}

.action-row {
  display: flex;
  gap: 10rpx;
}

.action-btn {
  flex: 1;
  min-height: 68rpx;
  border-radius: 12rpx;
  font-size: 29rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn-secondary {
  background: rgba(233, 174, 14, 0.14);
  color: #f7d06a;
}

.action-btn-danger {
  background: rgba(255, 107, 107, 0.14);
  color: #ffb2b2;
}
