page {
  background: #205D4C;
}

.page {
  min-height: 100vh;
  background: #205D4C;
}

.custom-nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 20;
  background: #205D4C;
}

.nav-bar {
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 22rpx;
  gap: 12rpx;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-text {
  color: #ffffff;
  font-size: 56rpx;
  line-height: 1;
}

.search-bar {
  flex: 1;
  height: 74rpx;
  border-radius: 38rpx;
  background: rgba(255, 255, 255, 0.94);
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  gap: 12rpx;
}

.camera-entry {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(32, 93, 76, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.camera-icon {
  width: 30rpx;
  height: 30rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1f2937;
}

.search-placeholder {
  color: #93a0ad;
}


.content-scroll {
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

.panel {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.panel-title {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 700;
}

.panel-action {
  color: rgba(255, 255, 255, 0.8);
  font-size: 26rpx;
}

.chip-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  max-width: 100%;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.more-chip {
  color: #E9AE0E;
}


.upload-preview {
  margin: 8rpx 0 18rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.preview-image {
  width: 92rpx;
  height: 92rpx;
  border-radius: 10rpx;
}

.preview-tip {
  flex: 1;
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
}

.result-head {
  margin-bottom: 16rpx;
}

.empty-box {
  padding: 60rpx 36rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.08);
  text-align: center;
}

.empty-text {
  color: rgba(255, 255, 255, 0.8);
  font-size: 28rpx;
  line-height: 1.6;
}

.manual-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding-bottom: 20rpx;
}

.manual-card {
  width: calc(50% - 12rpx);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.12);
  overflow: hidden;
  margin-bottom: 20rpx;
}

.card-img-area {
  width: 100%;
  height: 240rpx;
  background: rgba(255, 255, 255, 0.08);
}

.card-image {
  width: 100%;
  height: 100%;
}

.card-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-text {
  color: rgba(255, 255, 255, 0.7);
  font-size: 28rpx;
}

.card-name-area {
  min-height: 82rpx;
  padding: 16rpx;
  display: flex;
  align-items: center;
}

.card-name {
  color: #ffffff;
  font-size: 28rpx;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

