/* ========== 页面基础 ========== */
page {
  background: #205D4C;
}

.page {
  min-height: 100vh;
  background: #205D4C;
  display: flex;
  flex-direction: column;
}

/* ========== 自定义导航栏 ========== */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: transparent;
}

.nav-bar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 32rpx;
  position: relative;
}

.nav-ai-btn {
  width: 64rpx;
  height: 64rpx;
  background: #E9AE0E;
  border-radius: 20rpx 8rpx 20rpx 8rpx;
  flex-shrink: 0;
}

.nav-search {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.nav-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #ffffff;
  white-space: nowrap;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}

.nav-clear-btn {
  height: 64rpx;
  display: flex;
  align-items: center;
  padding: 0 8rpx;
  flex-shrink: 0;
}

.nav-clear-text {
  font-size: 26rpx;
  color: rgba(255,255,255,0.75);
}

.nav-mute-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: auto;
}

.nav-mute-text {
  font-size: 34rpx;
}

/* ========== 可滚动区域 ========== */
.main-scroll {
  background: #205D4C;
}

/* ========== 顶部快捷入口 ========== */
.quick-nav {
  display: flex;
  justify-content: center;
  gap: 100rpx;
  padding: 32rpx 0 40rpx;
}

.quick-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.quick-icon-wrap {
  position: relative;
  width: 80rpx;
  height: 80rpx;
}

.quick-icon {
  width: 80rpx;
  height: 80rpx;
}

.quick-badge {
  position: absolute;
  top: -8rpx;
  right: -12rpx;
  min-width: 34rpx;
  height: 34rpx;
  border-radius: 17rpx;
  background: #e63c3c;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.quick-badge-text {
  font-size: 18rpx;
  line-height: 1;
  color: #fff;
  font-weight: 700;
}

.quick-label {
  font-size: 24rpx;
  color: #ffffff;
}

/* ========== 消息列表 ========== */
.msg-list {
  padding: 0 24rpx;
}

.msg-item {
  display: flex;
  align-items: center;
  padding: 28rpx 16rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.msg-icon-wrap {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  overflow: visible;
}

.msg-icon-circle {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.22);
}

.msg-icon-circle-brand {
  background: rgba(255, 255, 255, 0.92);
}

.msg-icon {
  width: 100%;
  height: 100%;
  display: block;
}

.msg-icon-brand {
  border-radius: 50%;
  padding: 12rpx;
  box-sizing: border-box;
}

.msg-icon-system {
  padding: 10rpx;
  box-sizing: border-box;
}

.msg-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  background-color: #E63C3C;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
}

.msg-badge-text {
  font-size: 18rpx;
  color: #fff;
  font-weight: 600;
}

/* 免打扰时：无数字的小红点 */
.msg-badge-dot {
  min-width: 20rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  padding: 0;
}

.msg-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.msg-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #ffffff;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.msg-subtitle {
  font-size: 24rpx;
  color: #9B9DA9;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.msg-time {
  font-size: 22rpx;
  color: #9B9DA9;
  flex-shrink: 0;
  margin-left: 16rpx;
  white-space: nowrap;
}

/* ========== 陌生人消息区 ========== */
.stranger-section {
  margin: 8rpx 0;
}

.section-title {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
  padding: 16rpx 32rpx 8rpx;
}

.stranger-list {
  padding: 0 24rpx;
}

.s-item {
  display: flex;
  align-items: center;
  padding: 24rpx 16rpx;
  gap: 24rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.s-avatar-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
}

.s-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
}

.s-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.s-avatar-ph {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
}

.unread-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  background-color: #E63C3C;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

.unread-text {
  font-size: 20rpx;
  color: #fff;
  font-weight: 600;
}

.s-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.s-row-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.s-name {
  font-size: 30rpx;
  color: #fff;
  font-weight: 600;
}

.s-time {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
}

.s-preview {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.55);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
