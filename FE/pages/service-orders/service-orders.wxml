<view class="page">
  <view class="header">
    <text class="header-title">我的工单</text>
    <text class="header-subtitle">查看预约记录与处理进度</text>
  </view>

  <view class="loading" wx:if="{{loading}}">加载中...</view>

  <view class="empty" wx:elif="{{orders.length === 0}}">
    <text class="empty-title">暂无工单记录</text>
    <text class="empty-desc">可在工具箱发起远程指导预约</text>
    <view class="empty-btn" bindtap="onCreateTap">返回工具箱</view>
  </view>

  <scroll-view wx:else scroll-y class="order-scroll">
    <view
      class="order-card"
      wx:for="{{orders}}"
      wx:key="id"
      bindtap="onCardTap"
      data-id="{{item.id}}"
    >
      <view class="order-top">
        <text class="device-name">{{item.deviceName || '未命名设备'}}</text>
        <text class="status-tag status-{{item.status}}">{{item.statusText || '待处理'}}</text>
      </view>
      <text class="issue-desc">{{item.issueDesc || '待补充故障描述'}}</text>
      <view class="order-bottom">
        <text class="time-text">创建于 {{item.createdAtText}}</text>
        <view
          class="cancel-btn"
          wx:if="{{item.status !== 'canceled' && item.status !== 'done'}}"
          bindtap="onCancelTap"
          catchtap="onCancelTap"
          data-id="{{item.id}}"
        >取消</view>
      </view>
    </view>
  </scroll-view>
</view>
