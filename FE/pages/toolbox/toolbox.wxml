<view class="page">
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px">
    <view class="nav-bar">
      <view class="nav-ai-btn" bindtap="onQuarterTap"></view>
      <view class="nav-search" bindtap="onSearchTap">
        <image src="/images/home/MCPNG/search_3_line.png" class="nav-icon-img" mode="aspectFit"></image>
      </view>
      <text class="nav-title">工具箱</text>
    </view>
  </view>

  <view style="height: {{navHeight}}px"></view>

  <scroll-view scroll-y class="main-scroll" style="height: {{scrollHeight}}px">
    <view class="content-area">
      <view class="entry-banner" bindtap="onEnterpriseJoinTap">
        <view class="entry-tag">{{enterpriseBanner.tag}}</view>
        <view class="entry-title-row">
          <text class="entry-title">{{enterpriseBanner.title}}</text>
          <text class="entry-cta">{{enterpriseBanner.cta}}</text>
        </view>
        <text class="entry-desc">{{enterpriseBanner.desc}}</text>
      </view>

      <view class="section-block">
        <text class="section-title">企业服务</text>
        <view class="service-row">
          <view
            class="service-card"
            wx:for="{{enterpriseServices}}"
            wx:key="id"
            data-title="{{item.title}}"
            data-action="{{item.action}}"
            bindtap="onServiceTap"
          >
            <view class="service-icon">{{item.iconText}}</view>
            <text class="service-title">{{item.title}}</text>
            <text class="service-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>

      <view class="section-block">
        <text class="section-title">远程维修指导</text>
        <view class="remote-card" data-title="{{remoteGuideCard.title}}" data-action="{{remoteGuideCard.action}}" bindtap="onServiceTap">
          <view class="remote-head">
            <view class="remote-avatar"></view>
            <view class="remote-copy">
              <text class="remote-title">{{remoteGuideCard.title}}</text>
              <text class="remote-desc">{{remoteGuideCard.desc}}</text>
            </view>
          </view>
          <view class="remote-tags">
            <text class="tag-chip" wx:for="{{remoteGuideCard.tags}}" wx:key="*this">{{item}}</text>
          </view>
          <view class="remote-footer">
            <text class="remote-fee">{{remoteGuideCard.feeLabel}}</text>
            <view class="remote-btn">{{remoteGuideCard.cta}}</view>
          </view>
        </view>
      </view>

      <view class="section-block">
        <text class="section-title">实用工具</text>
        <view
          class="utility-item"
          wx:for="{{utilityTools}}"
          wx:key="id"
          data-title="{{item.title}}"
          data-action="{{item.action}}"
          bindtap="onServiceTap"
        >
          <view class="utility-main">
            <text class="utility-title">{{item.title}}</text>
            <text class="utility-subtitle">{{item.subtitle}}</text>
          </view>
          <text class="utility-arrow">></text>
        </view>
      </view>
    </view>
    <view style="height: {{tabBarHeight}}px;"></view>
  </scroll-view>
</view>
