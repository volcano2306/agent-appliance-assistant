.page-container {
  min-height: 100vh;
  background: #f2f6f4;
  padding: 24rpx;
  box-sizing: border-box;
}

.top-head {
  margin-bottom: 18rpx;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #1f5a4a;
}

.page-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6f877c;
}

.panel {
  background: #ffffff;
  border-radius: 18rpx;
  padding: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(20, 55, 45, 0.08);
}

.upload-box {
  border: 2rpx dashed #a6bbb1;
  border-radius: 14rpx;
  padding: 20rpx;
  background: #f9fcfa;
}

.image-box {
  margin-top: 12rpx;
}

.upload-main {
  display: block;
  color: #2a5a4b;
  font-size: 28rpx;
  font-weight: 700;
}

.upload-sub {
  display: block;
  margin-top: 8rpx;
  color: #7c9187;
  font-size: 22rpx;
}

.cover-preview {
  width: 180rpx;
  height: 180rpx;
  margin-top: 14rpx;
  border-radius: 12rpx;
  border: 1rpx solid #d8e4de;
}

.field-group {
  margin-top: 14rpx;
}

.field-label {
  display: block;
  color: #3c6356;
  font-size: 24rpx;
  margin-bottom: 6rpx;
}

.field-input {
  height: 72rpx;
  border-radius: 12rpx;
  background: #f2f6f4;
  padding: 0 16rpx;
  box-sizing: border-box;
  font-size: 26rpx;
}

.switch-row {
  margin-top: 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.switch-label {
  color: #355b4f;
  font-size: 26rpx;
}

.primary-btn {
  margin-top: 18rpx;
  width: 100%;
  height: 74rpx;
  border-radius: 12rpx;
  background: #1f5e4d;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.primary-btn.disabled {
  opacity: 0.6;
}
