# New API OpenAI-compatible Chat Completions API (legacy variable names)
DEEPSEEK_API_KEY=replace-with-your-newapi-key
DEEPSEEK_BASE_URL=https://windhub.cc/v1
DEEPSEEK_MODEL=qwen3.8-flash-next
# Only the official DeepSeek endpoint uses this switch.
DEEPSEEK_THINKING_ENABLED=false
# Optional JSON parameters confirmed by your gateway; {} sends none.
MODEL_EXTRA_BODY={}

# Service-to-service authentication (use the same value in Java)
AGENT_INTERNAL_TOKEN=replace-with-a-long-random-string
JAVA_BASE_URL=http://localhost:18083

# MongoDB + Qdrant
MONGODB_URI=mongodb://localhost:27017/jiadian
MONGODB_DATABASE=jiadian
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=manual_fragments
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# SerpAPI
SERPAPI_API_KEY=replace-with-your-serpapi-key
SERPAPI_BASE_URL=https://serpapi.com/search.json
# Normal Google Search supports Mainland China localization.
SERPAPI_COUNTRY=cn
SERPAPI_LANGUAGE=zh-cn
# Google Shopping does not support gl=cn; use a supported market.
SERPAPI_SHOPPING_COUNTRY=us
SERPAPI_SHOPPING_LANGUAGE=zh-cn
SERPAPI_GOOGLE_DOMAIN=google.com
SERPAPI_DEVICE=desktop
SERPAPI_TIMEOUT_SECONDS=20

# Tencent Cloud real-time ASR WebSocket
TENCENT_ASR_APP_ID=replace-with-your-appid
TENCENT_ASR_SECRET_ID=replace-with-your-secret-id
TENCENT_ASR_SECRET_KEY=replace-with-your-secret-key
TENCENT_ASR_ENGINE_MODEL_TYPE=16k_zh
TENCENT_ASR_WS_BASE=wss://asr.cloud.tencent.com/asr/v2

# Runtime controls
AGENT_HOST=0.0.0.0
AGENT_PORT=8001
AGENT_MAX_TOOL_ROUNDS=3
AGENT_MAX_SEARCH_RESULTS=5
AGENT_REQUEST_TIMEOUT_SECONDS=90
# On malformed raw final JSON, allow one <=15s formatting-only model call.
AGENT_FORMAT_REPAIR_ENABLED=true

# 会话记忆软阈值；主模型输入硬预算独立生效
MEMORY_ENABLED=false
MEMORY_EXECUTION_ENABLED=false
MEMORY_COMPRESSION_STRATEGY=threshold
MEMORY_TRIGGER_TOKENS=1500
MEMORY_MIN_GROWTH_TOKENS=500
# Preserve the existing 5-turn/600-token defaults (1000 remains supported).
MEMORY_RECENT_TURNS=5
MEMORY_SUMMARY_MAX_TOKENS=600
# When memory is enabled, explicitly confirm the gateway's actual context window.
# MEMORY_MODEL_CONTEXT_WINDOW=<confirmed integer, at least 27024 for default budgets>
