# Docker Compose only. Copy to .env locally; never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://windhub.cc/v1
DEEPSEEK_MODEL=qwen3.8-flash-next
# Generate a random token and share it between Agent and backend.
AGENT_INTERNAL_TOKEN=replace-with-a-long-random-string
MODEL_EXTRA_BODY={}
SERPAPI_API_KEY=
TENCENT_ASR_APP_ID=
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
# Memory is disabled by default. See docs/CONFIGURATION.md to enable both services.
MEMORY_ENABLED=false
MEMORY_EXECUTION_ENABLED=false
MEMORY_TRIGGER_TOKENS=1500
MEMORY_MIN_GROWTH_TOKENS=500
MEMORY_RECENT_TURNS=5
MEMORY_SUMMARY_MAX_TOKENS=600
# MEMORY_MODEL_CONTEXT_WINDOW=provider-confirmed-integer
